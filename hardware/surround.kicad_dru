(version 1)

# Custom DRC rules for the CNC-milled surround carrier board.
#
# Copper is isolation-milled with an 0.8 mm flat end mill, so 0.8 mm is the hard
# floor on any copper-to-copper gap. The Default netclass asks for 0.85 mm (the
# `cnc` fabrication profile), leaving ~0.025 mm of copper either side of the cut
# as margin for runout and registration.
#
# Every footprint was audited against that floor (tools/make_footprints.py and
# the stock picks). Only the 2.54 mm socket and header rows sit between the tool
# diameter and the netclass clearance, at 0.84 mm pad-to-pad, fixed by their own
# pin pitch:
#
#   A1   ESP32-DevKitC-38_Sockets           (two 1x19 socket rows)
#   A2   PinSocket_1x10_P2.54mm_Vertical    (DIR9001 module)
#   A3   GY-PCM5102_Carrier                 (1x6 socket row; the wire pads are 5.08 mm)
#   A4   GY-PCM5102_Carrier
#   J7   PinSocket_1x04_P2.54mm_Vertical    (OLED)
#   SW1  PinHeader_1x05_Encoder
#
# The rules relax the clearance ONLY between two items that both belong to one
# of those footprints. The full 0.85 mm stays in force everywhere else.
# Needing no exception: terminal blocks 2.08 mm, LED LaserPads 3.08 mm,
# barrel jack 1.20 mm, radial caps >= 1.9 mm, axial parts >= 6 mm.

(rule "A1_intra_pad_clearance"
	(condition "A.memberOfFootprint('A1') && B.memberOfFootprint('A1')")
	(constraint clearance (min 0.8mm)))
(rule "A2_intra_pad_clearance"
	(condition "A.memberOfFootprint('A2') && B.memberOfFootprint('A2')")
	(constraint clearance (min 0.8mm)))
(rule "A3_intra_pad_clearance"
	(condition "A.memberOfFootprint('A3') && B.memberOfFootprint('A3')")
	(constraint clearance (min 0.8mm)))
(rule "A4_intra_pad_clearance"
	(condition "A.memberOfFootprint('A4') && B.memberOfFootprint('A4')")
	(constraint clearance (min 0.8mm)))
(rule "J7_intra_pad_clearance"
	(condition "A.memberOfFootprint('J7') && B.memberOfFootprint('J7')")
	(constraint clearance (min 0.8mm)))
(rule "SW1_intra_pad_clearance"
	(condition "A.memberOfFootprint('SW1') && B.memberOfFootprint('SW1')")
	(constraint clearance (min 0.8mm)))
