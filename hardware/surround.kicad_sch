	(text "Power in  (9 V class II adapter -> reverse-polarity Schottky -> LM7805 for the audio modules, LM317 for the ESP32. Star ground at the input.)"
		(at 20.32 17.78 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f3422252-ce45-4f81-bf8d-ffa58764276d")
	)
	(text "R17-19: 10 R + 100 uF per module, ~160 Hz, 0.3 V drop at 30 mA; each module keeps its own LDO and bypass. R12/R13 sit at the LM317; C1 and C9 at U1 pin 2."
		(at 20.32 76.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a191a3c3-b11d-4a7c-8cb7-53a6e7114657")
	)
	(text "Signal chain  (TOSLINK -> DIR9001 clock recovery -> ESP32 I2S slave on both ports -> PCM5102A x2 in 3-wire BCK-PLL mode -> line out)"
		(at 20.32 93.98 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "b412fdec-5a1f-4b34-acd3-962c2027b3ca")
	)
	(text "Series source termination for the 71 R trace over the ground plane (tools/impedance.py):"
		(at 38.1 107.95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "53e0fe63-a858-42c0-9668-e10d621809a7")
	)
	(text "43R2 at every driver output (25-40 R CMOS source). Tune on a scope at the far pad."
		(at 38.1 110.49 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "39aa9261-3f46-4c40-a74b-bb87068d5add")
	)
	(text "Module DIP switches: FMT1=FMT0=H -> 24-bit I2S (DIR9001 Table 13)."
		(at 35.56 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e63a2154-9060-4226-af49-10840e44cceb")
	)
	(text "ERROR/AUDIO not brought out: firmware watches LRCK and the data."
		(at 35.56 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4f3d59af-24d9-4b12-adb8-57b289468274")
	)
	(text "IO12 must float (flash 1.8 V strap). IO2/IO15 strapping, IO6-11 flash: NC. Centre pad 39 unsoldered."
		(at 154.94 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "713e0da4-5fd7-4097-9938-a959956b73ab")
	)
	(text "Wi-Fi/BT and DFS disabled in firmware; audio task in IRAM."
		(at 154.94 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e06d24d4-e976-42c1-b443-5b297f6794a1")
	)
	(text "SCK=GND: 3-wire BCK-PLL mode. Module pads: FMT=L, FLT=L, DEMP=L,"
		(at 284.48 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d799f106-b84c-40af-986f-caa7a4b190bc")
	)
	(text "Modules face down on 1x6 + 1x9 sockets. XSMT jumper removed. VIN = 5 V via on-board LDO."
		(at 284.48 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "056d2028-edff-4f78-afe0-5d0babafc8f1")
	)
	(text "Fronts: panel RCA jacks on screw terminals, short cable to the Fosi amp. Module has 470 R + 2.2 nF out filter."
		(at 287.02 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "110bd7e5-a9d8-4d7d-999e-f59f434f1d6a")
	)
	(text "Panel TRS jacks on screw terminals, impedance-balanced to the Eris 3.5: 100 R tip, 100 R ring to GND."
		(at 248.92 194.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "36388a41-9256-4b82-a873-965935f68513")
	)
	(text "ESP32 support and user interface  (no auto-reset: hold BOOT, tap RESET to flash over the UART header. Pot on ADC1, 1k in series because it lives on flying leads.)"
		(at 20.32 185.42 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "ca82cf6b-a8ae-46e9-8f8d-578a3c879edf")
	)
