	(text "Power in  (5 V class II adapter -> PTC -> 470 uF bulk; ferrite + 100 uF per module rail. Star ground at the jack.)"
		(at 20.32 17.78 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f44fb8af-875c-420d-a3a9-9e1b5521d933")
	)
	(text "FB1-3: axial bead on lead, ~600 R @ 100 MHz, DCR < 0.3 R. Each module keeps its own 100 nF + 10 uF at the pin. Never power from a PC USB port."
		(at 20.32 76.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1fa201ae-0d3c-4bfb-9610-afb795c45e2d")
	)
	(text "Signal chain  (TOSLINK -> DIR9001 clock recovery -> ESP32 I2S slave on both ports -> PCM5102A x2 in 3-wire BCK-PLL mode -> line out)"
		(at 20.32 93.98 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "7155e290-a7db-4992-9399-dbd39ed037df")
	)
	(text "Series source termination, sized to the 86 R coplanar trace (tools/impedance.py):"
		(at 38.1 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "952de0b5-d005-4bd7-a37e-e93ac32a6397")
	)
	(text "56 R at every driver output (92 R line, 25-40 R CMOS source). Tune on a scope at the far pad."
		(at 38.1 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4b5b70cd-fdc6-4e3c-b448-f34da82bd182")
	)
	(text "FMT1=FMT0=H -> 24-bit I2S (DIR9001 Table 13). CKSEL=L, XTI=GND,"
		(at 35.56 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "92e1095a-916e-4913-9492-bd6be47e4489")
	)
	(text "PSCK=LL. Unlock: clocks free-run, DOUT mutes, ERROR=H."
		(at 35.56 144.78 0)
